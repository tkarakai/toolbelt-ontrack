{
  "formatVersion": 1,
  "id": "ontrack",
  "name": "OnTrack",
  "description": "Simple, flexible task tracking with colored labels, due dates and related tasks.",
  "icon": "list-checks",
  "version": "0.0.1",
  "protocol": 1,
  "entry": "index.js",
  "repo": "tkarakai/toolbelt-ontrack",
  "requires": {
    "host": ">=0.3.5",
    "bun": ">=1.3.0",
    "platforms": ["portable"]
  },
  "capabilities": {
    "required": ["ui.core", "ui.action-key", "lifecycle"],
    "optional": []
  },
  "data": { "schema": 1 },
  "migration": { "entry": "migrate.js" },
  "screens": [
    { "id": "tasks", "title": "Tasks", "icon": "list-checks", "default": true, "shortcut": "t" },
    { "id": "labels", "title": "Labels", "icon": "tags", "shortcut": "l" }
  ],
  "quickView": true
}
