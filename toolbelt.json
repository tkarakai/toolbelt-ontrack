{
  "formatVersion": 1,
  "id": "ontrack",
  "name": "OnTrack",
  "description": "Tasks you manage yourself: an Inbox, Working, Snoozed and Settled, with colored labels, due dates and related tasks.",
  "icon": "list-checks",
  "version": "0.4.0",
  "protocol": 1,
  "entry": "index.js",
  "repo": "tkarakai/toolbelt-ontrack",
  "requires": {
    "host": ">=0.3.12",
    "bun": ">=1.3.0",
    "platforms": [
      "portable"
    ]
  },
  "capabilities": {
    "required": [
      "ui.core",
      "ui.action-key",
      "lifecycle",
      "ui.split-action",
      "ui.rich-fields",
      "ui.row-select",
      "ui.row-reorder",
      "ui.modifier-keys",
      "ui.timeline",
      "ui.row-pane",
      "ui.composer"
    ],
    "optional": []
  },
  "data": {
    "schema": 3
  },
  "migration": {
    "entry": "migrate.js"
  },
  "screens": [
    {
      "id": "tasks",
      "title": "Tasks",
      "icon": "list-checks",
      "default": true,
      "shortcut": "t"
    },
    {
      "id": "labels",
      "title": "Settings",
      "icon": "settings",
      "shortcut": "s"
    }
  ],
  "quickView": true
}
