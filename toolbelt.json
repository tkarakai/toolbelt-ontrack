{
  "formatVersion": 1,
  "id": "ontrack",
  "name": "OnTrack",
  "description": "Tasks you manage yourself: an Inbox, Working, Stalled, Watching, Snoozed and Settled, with colored labels, due dates and related tasks.",
  "icon": "list-checks",
  "version": "0.14.0",
  "protocol": 2,
  "agent": {
    "access": "read"
  },
  "entry": "index.js",
  "repo": "tkarakai/toolbelt-ontrack",
  "requires": {
    "host": ">=0.6.0",
    "bun": ">=1.3.0",
    "platforms": [
      "portable"
    ]
  },
  "capabilities": {
    "required": [
      "ui.core",
      "ui.action-key",
      "lifecycle",
      "ui.split-action",
      "ui.rich-fields",
      "ui.row-select",
      "ui.row-reorder",
      "ui.modifier-keys",
      "ui.timeline",
      "ui.row-pane",
      "ui.composer",
      "assets",
      "ui.sub-sections",
      "ui.toast-key",
      "ui.options-field",
      "ui.nested-sections",
      "ui.filter-group",
      "ui.row-tree",
      "ui.choice-control",
      "ui.context-select",
      "ui.section-pill",
      "ui.row-dot",
      "ui.pane-buttons",
      "ui.tag-multiple",
      "ui.heading-note",
      "ui.cell-prefix",
      "ui.list-open",
      "ui.tag-open",
      "ui.duration-field"
    ],
    "optional": [
      "navigate",
      "ui.list-inset",
      "ui.filter-sections"
    ]
  },
  "data": {
    "schema": 8
  },
  "migration": {
    "entry": "migrate.js"
  },
  "screens": [
    {
      "id": "tasks",
      "title": "Tasks",
      "icon": "list-checks",
      "default": true,
      "shortcut": "t"
    },
    {
      "id": "labels",
      "title": "Settings",
      "icon": "settings",
      "shortcut": "s"
    }
  ],
  "assets": {
    "state-inbox": "assets/state-inbox.svg",
    "state-progressing": "assets/state-progressing.svg",
    "state-working": "assets/state-working.svg",
    "state-stalled": "assets/state-stalled.svg",
    "state-snoozed": "assets/state-snoozed.svg",
    "state-watching": "assets/state-watching.svg",
    "state-settled": "assets/state-settled.svg"
  },
  "quickView": true
}
