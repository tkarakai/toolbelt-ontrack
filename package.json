{
  "name": "toolbelt-ontrack",
  "version": "0.13.2",
  "private": true,
  "description": "Simple, flexible task tracking with colored labels and related tasks. A Toolbelt plugin.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
    "release:plugin": "bun run --bun toolbelt-release plugin",
    "release:plugin:retry": "bun run --bun toolbelt-release plugin:retry"
  },
  "dependencies": {
    "@toolbelt/sdk": "https://github.com/tkarakai/toolbelt/releases/download/sdk-v0.3.17/toolbelt-sdk-0.3.17.tgz"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "~7.0.2"
  }
}
